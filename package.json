{
  "name": "cybranex-workos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:backend": "pnpm --filter \"backend...\" build",
    "build:frontend": "pnpm --filter \"frontend...\" build",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "typecheck:frontend": "pnpm --filter frontend build",
    "dev": "pnpm --parallel --filter backend --filter frontend dev",
    "local:setup": "node scripts/local-dev.mjs setup",
    "test:local:native": "node scripts/local-dev.mjs test-native",
    "test:local:sales": "node scripts/local-dev.mjs test-sales",
    "verify:local:phase1": "node scripts/local-dev.mjs verify-phase1",
    "verify:local:phase2": "node scripts/local-dev.mjs verify-phase2",
    "dev:local": "node scripts/local-dev.mjs both",
    "dev:local:backend": "node scripts/local-dev.mjs backend",
    "dev:local:worker": "node scripts/local-dev.mjs worker",
    "dev:local:frontend": "node scripts/local-dev.mjs frontend"
  },
  "pnpm": {
    "overrides": {
      "google-auth-library": "10.9.0",
      "zustand": "5.0.14"
    }
  }
}
