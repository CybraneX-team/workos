{
  "name": "erpnext-control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../backend/.env --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../backend/.env --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed:sales": "node --env-file-if-exists=../backend/.env --env-file-if-exists=.env --import tsx scripts/seed.ts --kind=sales",
    "seed:operations": "node --env-file-if-exists=../backend/.env --env-file-if-exists=.env --import tsx scripts/seed.ts --kind=operations",
    "test": "node --env-file-if-exists=../backend/.env --env-file-if-exists=.env --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@cybranex/erpnext-contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
