PORT=8080
SUPABASE_URL=https://wcovyctzfgpqifelefum.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
WORKER_ID=local
RUN_WORKER=true
SUPABASE_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:5173

ENCRYPTION_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ERPNext integration. Only the control-plane owns Frappe credentials and Docker access.
ERPNEXT_CONTROL_PLANE_URL=http://localhost:8090
ERPNEXT_CONTROL_PLANE_TOKEN=
ERPNEXT_TARGET_ENV=local
RUN_ERPNEXT_OUTBOX_WORKER=true
OIDC_BROWSER_AUTHORIZE_URL=http://localhost:5173/oauth/authorize
OIDC_INTERNAL_BASE_URL=http://host.docker.internal:8080/api/oidc

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8080/api/integrations/meta/callback
META_GRAPH_API_VERSION=v25.0
# Meta sandbox connect (dev only). Generate the token from the App dashboard:
# Marketing API → Tools → your sandbox ad account row → key icon → Generate.
# Only usable when NODE_ENV != production and the caller's user id is in the allowlist.
META_SANDBOX_ACCESS_TOKEN=
META_SANDBOX_AD_ACCOUNT_ID=
META_SANDBOX_ALLOWED_USER_IDS=

# SMTP — used to send join-request and invite-credential emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Startup Digital Twin <no-reply@startup-digital-twin.com>

# Salesforce OAuth (create a Connected App in Salesforce Setup -> App Manager)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8080/api/integrations/salesforce/callback

# Razorpay credentials are supplied per-company by each user through the UI.

# HubSpot token is supplied per-company by each user through the UI.

# QuickBooks OAuth (create an app at developer.intuit.com -> your app -> Keys & OAuth)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8080/api/integrations/quickbooks/callback
# Set to "false" to use production API instead of sandbox.
QUICKBOOKS_SANDBOX=true
